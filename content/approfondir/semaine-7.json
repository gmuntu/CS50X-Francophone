    {
      "id": "crud-sql",
      "titre": "CRUD et les commandes SQL",
      "resume": "On fait quatre choses avec des données : les créer, les lire, les mettre à jour et les supprimer ; en SQL, ce sont INSERT, SELECT, UPDATE et DELETE.",
      "page": "§ Application dans les bases de données",
      "documentId": "wp-crud",
      "schema": {
        "type": "relations",
        "liens": [
          {
            "de": "Create (créer)",
            "vers": "INSERT INTO favoris (langage) VALUES ('Python');",
            "label": "en SQL"
          },
          {
            "de": "Read (lire)",
            "vers": "SELECT langage FROM favoris;",
            "label": "en SQL"
          },
          {
            "de": "Update (modifier)",
            "vers": "UPDATE favoris SET langage = 'C' WHERE id = 1;",
            "label": "en SQL"
          },
          {
            "de": "Delete (supprimer)",
            "vers": "DELETE FROM favoris WHERE id = 1;",
            "label": "en SQL"
          }
        ]
      },
      "passages": [
        {
          "texte": "CRUD désigne les quatre opérations de base sur des données : créer, lire, mettre à jour et supprimer ; en SQL elles correspondent à INSERT, SELECT, UPDATE et DELETE.",
          "documentId": "wp-crud",
          "page": "§ Application dans les bases de données"
        },
        {
          "texte": "Les instructions de manipulation de données permettent d'ajouter, de modifier, de supprimer et de rechercher des lignes dans les tables.",
          "documentId": "wp-sql",
          "page": "§ Langage de manipulation de données"
        },
        {
          "texte": "SELECT peut filtrer avec WHERE, trier avec ORDER BY, regrouper avec GROUP BY et compter avec COUNT.",
          "documentId": "wp-sql",
          "page": "§ Manipulation de données"
        }
      ],
      "infographie": {
