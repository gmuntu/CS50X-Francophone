    {
      "id": "hexadecimal",
      "titre": "L'hexadécimal et les adresses",
      "resume": "L'hexadécimal compte en base 16 (0 à 9 puis A à F) : un chiffre hexadécimal remplace 4 bits, ce qui rend les adresses mémoire plus courtes à lire.",
      "page": "§ Écriture des entiers",
      "documentId": "wp-hexa",
      "schema": {
        "type": "etapes",
        "etapes": [
          {
            "titre": "Base 16",
            "texte": "Chiffres 0 1 2 … 9 A B C D E F."
          },
          {
            "titre": "4 bits = 1 chiffre",
            "texte": "1111 en binaire = F."
          },
          {
            "titre": "1 octet = 2 chiffres",
            "texte": "11111111 = FF = 255."
          },
          {
            "titre": "Préfixe 0x",
            "texte": "Une adresse s'écrit 0x7ffc… pour dire « hexadécimal »."
          }
        ]
      },
      "differences": {
        "titres": [
          "Décimal",
          "Hexadécimal"
        ],
        "lignes": [
          {
            "critere": "Chiffres",
            "a": "0 à 9",
            "b": "0 à 9 puis A à F"
          },
          {
            "critere": "255",
            "a": "255",
            "b": "FF"
          },
          {
            "critere": "Usage",
            "a": "La vie courante",
            "b": "Adresses mémoire, couleurs (#FF0000)"
          }
        ]
      },
      "passages": [
        {
          "texte": "Le système hexadécimal utilise seize symboles : les chiffres de 0 à 9 et les lettres A à F, qui valent de 10 à 15.",
          "documentId": "wp-hexa",
          "page": "§ Écriture des entiers"
        },
        {
          "texte": "Chaque chiffre hexadécimal correspond exactement à quatre bits : c'est une façon compacte d'écrire du binaire, très utilisée en informatique.",
          "documentId": "wp-hexa",
          "page": "§ Utilisation"
        },
        {
          "texte": "En HTML, une couleur s'écrit avec trois octets en hexadécimal : #FF0000 donne du rouge.",
          "documentId": "wp-hexa",
          "page": "§ Codage des couleurs"
        }
      ],
      "infographie": {
        "titre": "Compter jusqu'à F",
        "points": [
          {
            "icone": "🔢",
            "texte": "0…9 puis A=10 … F=15."
          },
          {
            "icone": "🧱",
            "texte": "1 chiffre hexa = 4 bits."
          },
          {
            "icone": "📍",
            "texte": "Adresses : 0x1A2B…"
          },
          {
            "icone": "🎨",
            "texte": "Couleurs web : #RRVVBB."
          }
        ]
      }
    },
    {
      "id": "pointeurs",
      "titre": "Les pointeurs, & et *",
      "resume": "Un pointeur est une variable qui contient l'adresse d'une autre variable : & donne l'adresse, * va chercher la valeur à cette adresse.",
      "page": "Pointeurs, § Usage et déclaration",
      "documentId": "wb-pointeurs",
      "schema": {
        "type": "relations",
        "liens": [
          {
            "de": "int n = 50;",
            "vers": "une case contenant 50",
            "label": "crée"
          },
          {
            "de": "&n",
            "vers": "l'adresse de n (0x123…)",
            "label": "donne"
          },
          {
            "de": "int *p = &n;",
            "vers": "p contient l'adresse de n",
            "label": "range"
          },
          {
            "de": "*p",
            "vers": "50",
            "label": "va chercher"
          }
        ]
      },
      "differences": {
        "titres": [
          "&  (adresse de)",
          "*  (déréférencement)"
        ],
        "lignes": [
          {
            "critere": "Question posée",
            "a": "Où est rangée la variable ?",
            "b": "Qu'y a-t-il à cette adresse ?"
          },
          {
            "critere": "Exemple",
            "a": "&n → 0x7ffc…",
            "b": "*p → 50"
          },
          {
            "critere": "Image",
            "a": "Le numéro de la boîte aux lettres",
            "b": "Le courrier dans la boîte"
          }
        ]
      },
      "passages": [
        {
          "texte": "Un pointeur est une variable dont la valeur est l'adresse d'une autre variable ; on le déclare avec une étoile : int *p.",
          "documentId": "wb-pointeurs",
          "page": "§ Usage et déclaration"
        },
        {
          "texte": "L'opérateur * appliqué à un pointeur donne accès à la valeur stockée à l'adresse qu'il contient : c'est le déréférencement.",
          "documentId": "wb-pointeurs",
          "page": "§ Déréférencement"
        },
        {
          "texte": "Les pointeurs permettent de passer une donnée à une fonction sans la copier et de manipuler des zones de mémoire réservées pendant l'exécution.",
          "documentId": "wp-pointeur",
          "page": "§ Utilité"
        }
      ],
      "infographie": {
        "titre": "Une adresse dans une variable",
        "points": [
          {
            "icone": "🏠",
            "texte": "Chaque variable a une adresse."
          },
          {
            "icone": "📮",
            "texte": "&n : l'adresse de n."
          },
          {
            "icone": "👉",
            "texte": "int *p : p pointe vers un int."
          },
          {
            "icone": "📬",
            "texte": "*p : la valeur pointée."
          }
        ]
      }
    },
    {
      "id": "chaines-pointeurs",
      "titre": "Une chaîne, c'est un pointeur",
      "resume": "En C, le type string de CS50 est en réalité char * : l'adresse du premier caractère, la suite étant lue jusqu'au '\\0'.",
      "page": "Pointeurs, § L'arithmétique des pointeurs",
      "documentId": "wb-pointeurs",
      "schema": {
        "type": "etapes",
        "etapes": [
          {
            "titre": "char *s = \"HI!\";",
            "texte": "s contient l'adresse du 'H'."
          },
          {
            "titre": "*s",
            "texte": "vaut 'H'."
          },
          {
            "titre": "*(s + 1)",
            "texte": "vaut 'I' : on avance d'une case."
          },
          {
            "titre": "s == t ?",
            "texte": "Compare les adresses, pas le texte : utiliser strcmp."
          }
        ]
      },
      "passages": [
        {
          "texte": "Ajouter 1 à un pointeur le fait avancer d'un élément du type pointé : p + 1 désigne la case suivante.",
          "documentId": "wb-pointeurs",
          "page": "§ Arithmétique de base"
        },
        {
          "texte": "Pour qu'une fonction modifie une variable de l'appelant, comme dans swap, on lui passe l'adresse de cette variable.",
          "documentId": "wb-pointeurs",
          "page": "§ Utilisation des pointeurs pour passer des paramètres par adresse"
        }
      ],
      "infographie": {
        "titre": "Ce que cache string",
        "points": [
          {
            "icone": "🔤",
            "texte": "string = char *."
          },
          {
            "icone": "📍",
            "texte": "s = adresse du premier caractère."
          },
          {
            "icone": "➕",
            "texte": "s + 1 = caractère suivant."
          },
          {
            "icone": "⚠️",
            "texte": "Comparer deux textes : strcmp, pas ==."
          }
        ]
      }
    },
    {
      "id": "malloc-free",
      "titre": "malloc et free",
      "resume": "malloc réserve de la mémoire pendant l'exécution et renvoie son adresse ; free la rend quand on n'en a plus besoin.",
      "page": "Gestion de la mémoire, § malloc: allocation de mémoire",
      "documentId": "wb-memoire",
      "schema": {
        "type": "etapes",
        "etapes": [
          {
            "titre": "Réserver",
            "texte": "char *t = malloc(4); demande 4 octets."
          },
          {
            "titre": "Vérifier",
            "texte": "Si t vaut NULL, il n'y a plus de mémoire : arrêter."
          },
          {
            "titre": "Utiliser",
            "texte": "Copier, écrire, lire dans t."
          },
          {
            "titre": "Libérer",
            "texte": "free(t); rend la mémoire."
          }
        ]
      },
      "passages": [
        {
          "texte": "malloc alloue un bloc du nombre d'octets demandé et renvoie un pointeur vers son début, ou NULL si l'allocation échoue.",
          "documentId": "wb-memoire",
          "page": "§ malloc: allocation de mémoire"
        },
        {
          "texte": "free libère un bloc précédemment alloué ; il ne faut plus l'utiliser ensuite, ni le libérer deux fois.",
          "documentId": "wb-memoire",
          "page": "§ free: libération de mémoire"
        },
        {
          "texte": "malloc sert quand la taille des données n'est connue qu'à l'exécution, ou quand elles doivent survivre à la fonction qui les crée.",
          "documentId": "wp-malloc",
          "page": "§ Motivation"
        }
      ],
      "infographie": {
        "titre": "Emprunter puis rendre",
        "points": [
          {
            "icone": "🙋",
            "texte": "malloc : je réserve."
          },
          {
            "icone": "🔍",
            "texte": "NULL ? Plus de place."
          },
          {
            "icone": "✍️",
            "texte": "J'utilise la mémoire."
          },
          {
            "icone": "↩️",
            "texte": "free : je rends."
          }
        ]
      }
    },
    {
