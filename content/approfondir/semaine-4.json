      "passages": [
        {
          "texte": "La pile d'exécution enregistre les informations des fonctions en cours : à chaque appel, un cadre est empilé ; il est dépilé quand la fonction se termine.",
          "documentId": "wp-pile",
          "page": "§ Introduction"
        },
        {
          "texte": "Le tas est la zone de mémoire dans laquelle le programme réserve dynamiquement des blocs pendant son exécution, par exemple avec malloc.",
          "documentId": "wp-tas",
          "page": "§ Introduction"
        }
      ],
      "infographie": {
