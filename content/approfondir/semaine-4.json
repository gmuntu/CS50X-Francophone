    {
      "id": "valgrind-fuites",
      "titre": "Fuites de mémoire et Valgrind",
      "resume": "Une fuite de mémoire, c'est de la mémoire réservée jamais libérée ; Valgrind exécute le programme et signale fuites et accès interdits.",
      "page": "§ Présentation",
      "documentId": "wp-fuite",
      "schema": {
        "type": "cycle",
        "etapes": [
          {
            "titre": "Lancer",
            "texte": "valgrind ./programme"
          },
          {
            "titre": "Lire le rapport",
            "texte": "« definitely lost », « invalid write »…"
          },
          {
            "titre": "Corriger",
            "texte": "Ajouter le free manquant, corriger l'indice."
          },
          {
            "titre": "Relancer",
            "texte": "Jusqu'à « All heap blocks were freed »."
          }
        ]
      },
      "passages": [
        {
          "texte": "Une fuite de mémoire se produit quand un programme réserve de la mémoire et ne la libère pas : elle reste occupée et inutilisable.",
          "documentId": "wp-fuite",
          "page": "§ Présentation"
        },
        {
          "texte": "Un programme qui fuit consomme de plus en plus de mémoire, ce qui peut ralentir puis bloquer l'ordinateur.",
          "documentId": "wp-fuite",
          "page": "§ Conséquences"
        },
        {
          "texte": "Valgrind exécute le programme dans un environnement contrôlé et détecte les fuites de mémoire et les lectures ou écritures dans des zones non autorisées.",
          "documentId": "wp-valgrind",
          "page": "§ Débogueur"
        },
        {
          "texte": "Un pointeur non initialisé contient une valeur au hasard (garbage value) : s'en servir peut écrire n'importe où en mémoire.",
          "documentId": "wb-memoire",
          "page": "§ Défaut d'initialisation d'un pointeur"
        }
      ],
      "infographie": {
        "titre": "Chasser les fuites",
        "points": [
