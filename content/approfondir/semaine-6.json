          {
            "critere": "Fin d'instruction",
            "a": "Point-virgule",
            "b": "Fin de ligne"
          },
          {
            "critere": "Blocs",
            "a": "Accolades { }",
            "b": "Indentation (espaces)"
          }
        ]
      },
      "passages": [
        {
          "texte": "Un interprète analyse et exécute les instructions d'un programme au fur et à mesure, sans produire au préalable un fichier exécutable.",
          "documentId": "wp-interprete",
          "page": "§ Principe"
        },
        {
          "texte": "En pratique, Python traduit d'abord le code en bytecode, une forme intermédiaire, que sa machine virtuelle exécute ensuite.",
          "documentId": "wp-interprete",
          "page": "§ Les interprètes de bytecode"
        },
        {
          "texte": "Python utilise l'indentation pour délimiter les blocs, ce qui rend le code lisible et oblige à le présenter proprement.",
          "documentId": "wp-python",
          "page": "§ Syntaxe"
        }
      ],
      "infographie": {
        "titre": "Python en un coup d'œil",
        "points": [
          {
            "icone": "▶️",
            "texte": "python hello.py : ça tourne tout de suite."
          },
          {
            "icone": "➖",
            "texte": "Pas de point-virgule."
          },
          {
            "icone": "↹",
            "texte": "L'indentation fait les blocs."
          },
          {
            "icone": "⏱️",
            "texte": "Plus lent que le C, mais plus court à écrire."
          }
        ]
      }
