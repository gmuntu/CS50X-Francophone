    {
      "id": "typage-dynamique",
      "titre": "Le typage dynamique",
      "resume": "En Python, on n'écrit pas le type d'une variable : il est déterminé pendant l'exécution, d'après la valeur qu'elle contient.",
      "page": "§ Typage dynamique",
      "documentId": "wp-typage",
      "schema": {
        "type": "etapes",
        "etapes": [
          {
            "titre": "x = 50",
            "texte": "x contient un entier (int)."
          },
          {
            "titre": "x = \"bonjour\"",
            "texte": "La même variable contient maintenant un texte (str)."
          },
          {
            "titre": "type(x)",
            "texte": "Python dit quel est le type actuel."
          },
          {
            "titre": "Attention",
            "texte": "\"1\" + 1 provoque une erreur : convertir avec int(\"1\")."
          }
        ]
      },
      "differences": {
        "titres": [
          "Typage statique (C)",
          "Typage dynamique (Python)"
        ],
        "lignes": [
          {
            "critere": "Déclaration",
            "a": "int x = 50;",
            "b": "x = 50"
          },
          {
            "critere": "Vérification",
            "a": "À la compilation",
            "b": "À l'exécution"
          },
          {
            "critere": "Changer de type",
            "a": "Impossible",
            "b": "Possible"
          }
        ]
      },
      "passages": [
        {
          "texte": "Avec le typage dynamique, le type est associé à la valeur et non à la variable : il est vérifié au moment de l'exécution.",
          "documentId": "wp-typage",
          "page": "§ Typage dynamique"
        },
        {
          "texte": "Le typage dynamique rend le code plus court et souple, mais certaines erreurs de type n'apparaissent qu'au moment où la ligne est exécutée.",
          "documentId": "wp-typage",
          "page": "§ Implications du typage dynamique"
        }
      ],
      "infographie": {
        "titre": "Pas besoin de dire le type",
        "points": [
          {
            "icone": "🏷️",
            "texte": "Le type suit la valeur."
          },
          {
            "icone": "🔄",
            "texte": "Une variable peut changer de type."
          },
          {
            "icone": "🔍",
            "texte": "type(x) pour vérifier."
          },
          {
            "icone": "⚠️",
            "texte": "Erreurs vues seulement à l'exécution."
          }
        ]
      }
