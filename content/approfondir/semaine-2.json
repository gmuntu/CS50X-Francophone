    {
      "id": "chaines-nul",
      "titre": "Les chaînes et le caractère nul",
      "resume": "En C, un texte est un tableau de caractères qui se termine par un octet spécial, le caractère nul '\\0', qui indique où il s'arrête.",
      "page": "§ Représentation en mémoire",
      "documentId": "wp-chaine",
      "schema": {
        "type": "etapes",
        "etapes": [
          {
            "titre": "string s = \"HI!\";",
            "texte": "On écrit 3 caractères."
          },
          {
            "titre": "En mémoire : 4 octets",
            "texte": "'H' 'I' '!' puis '\\0'."
          },
          {
            "titre": "Lire jusqu'au '\\0'",
            "texte": "printf et strlen s'arrêtent au caractère nul."
          },
          {
            "titre": "Longueur",
            "texte": "strlen(s) vaut 3 : le '\\0' n'est pas compté."
          }
        ]
      },
      "differences": {
        "titres": [
          "'A' (caractère)",
          "\"A\" (chaîne)"
        ],
        "lignes": [
          {
            "critere": "Guillemets",
            "a": "Simples",
            "b": "Doubles"
          },
          {
            "critere": "Type",
            "a": "char",
            "b": "string (tableau de char)"
          },
          {
            "critere": "Octets en mémoire",
            "a": "1",
            "b": "2 ('A' puis '\\0')"
          }
        ]
      },
      "passages": [
        {
          "texte": "En C, une chaîne est représentée par une suite de caractères terminée par un caractère nul ; sa longueur n'est pas enregistrée, on la retrouve en cherchant ce caractère.",
          "documentId": "wp-chaine",
          "page": "§ Représentation en mémoire"
        },
        {
          "texte": "Le caractère nul a pour code 0 : tous ses bits valent zéro. Il sert de marqueur de fin de chaîne dans de nombreux langages.",
          "documentId": "wp-nul",
          "page": "§ Codage"
        },
        {
          "texte": "La fonction strlen renvoie la longueur d'une chaîne, sans compter le caractère nul final.",
          "documentId": "wb-chaines",
          "page": "Chaînes de caractères, § Longueur d'une chaîne"
        }
      ],
      "infographie": {
        "titre": "Où s'arrête le texte ?",
        "points": [
          {
            "icone": "🔤",
            "texte": "Une chaîne = des char côte à côte."
          },
          {
            "icone": "🛑",
            "texte": "Le '\\0' marque la fin."
          },
          {
            "icone": "➕",
            "texte": "\"HI!\" occupe 4 octets, pas 3."
          },
          {
            "icone": "📏",
            "texte": "strlen ne compte pas le '\\0'."
          }
        ]
      }
    },
    {
      "id": "transtypage",
      "titre": "Le transtypage (casting)",
      "resume": "Transtyper, c'est convertir une valeur d'un type à un autre : en C, une lettre est aussi un nombre, ce qui permet de calculer avec.",
