      "passages": [
        {
          "texte": "La conversion de type change la représentation d'une valeur d'un type vers un autre. Elle peut être implicite, faite par le compilateur, ou explicite, demandée par le programmeur.",
          "documentId": "wp-conversion",
          "page": "§ Introduction"
        }
      ],
      "infographie": {
        "titre": "Les lettres sont des nombres",
        "points": [
