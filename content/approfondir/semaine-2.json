    {
      "id": "cesar",
      "titre": "Le chiffre de César et la cryptographie",
      "resume": "Le chiffre de César cache un message en décalant chaque lettre d'un même nombre de places dans l'alphabet ; c'est le principe de base de la cryptographie.",
      "page": "§ Exemple",
      "documentId": "wp-cesar",
      "schema": {
        "type": "etapes",
        "etapes": [
          {
            "titre": "Texte clair",
            "texte": "HI"
          },
          {
            "titre": "Clé",
            "texte": "Décaler de 1."
          },
          {
            "titre": "Texte chiffré",
            "texte": "IJ (H → I, I → J)."
          },
          {
            "titre": "Déchiffrer",
            "texte": "Décaler de 1 dans l'autre sens pour retrouver HI."
          }
        ]
      },
      "differences": {
        "titres": [
          "Chiffrer",
          "Déchiffrer"
        ],
        "lignes": [
          {
            "critere": "Entrée",
            "a": "Texte clair + clé",
            "b": "Texte chiffré + clé"
          },
          {
            "critere": "Opération",
            "a": "Décaler en avant",
            "b": "Décaler en arrière"
          },
          {
            "critere": "Après Z",
            "a": "On revient à A (modulo 26)",
            "b": "Avant A, on revient à Z"
          }
        ]
      },
      "passages": [
        {
          "texte": "Le chiffrement par décalage remplace chaque lettre par la lettre située un nombre fixe de positions plus loin dans l'alphabet ; Jules César aurait utilisé un décalage de 3.",
          "documentId": "wp-cesar",
          "page": "§ Exemple"
        },
        {
          "texte": "Avec seulement 25 décalages possibles, ce chiffre se casse facilement en les essayant tous, ou par l'analyse de la fréquence des lettres.",
          "documentId": "wp-cesar",
          "page": "§ Attaques"
        },
        {
          "texte": "La cryptographie protège des messages pour en assurer la confidentialité, l'authenticité et l'intégrité, en s'aidant de secrets appelés clés.",
          "documentId": "wp-crypto",
          "page": "§ Étymologie et vocabulaire"
        },
        {
          "texte": "Le chiffre de César fait partie des algorithmes de chiffrement faibles, facilement déchiffrables ; les systèmes modernes utilisent des clés bien plus longues.",
          "documentId": "wp-crypto",
          "page": "§ Algorithmes de chiffrement faible (facilement déchiffrables)"
        }
      ],
      "infographie": {
        "titre": "Cacher un message",
        "points": [
          {
            "icone": "🔑",
            "texte": "Une clé : le nombre de décalages."
          },
          {
            "icone": "➡️",
            "texte": "Chiffrer : A + 3 = D."
          },
          {
            "icone": "🔄",
            "texte": "Après Z, on repart à A."
          },
          {
            "icone": "🔓",
            "texte": "Faible : 25 essais suffisent pour le casser."
          }
        ]
      }
