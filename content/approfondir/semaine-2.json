    {
      "id": "tableaux",
      "titre": "Le tableau",
      "resume": "Un tableau range plusieurs valeurs du même type côte à côte en mémoire, et on accède à chacune par son indice, à partir de 0.",
      "page": "Tableaux, § Accès aux éléments",
      "documentId": "wb-tableaux",
      "schema": {
        "type": "etapes",
        "etapes": [
          {
            "titre": "Déclarer",
            "texte": "int notes[3]; réserve 3 cases d'entiers côte à côte."
          },
          {
            "titre": "Remplir",
            "texte": "notes[0] = 72; notes[1] = 73; notes[2] = 33;"
          },
          {
            "titre": "Lire",
            "texte": "notes[1] vaut 73 : l'indice commence à 0."
          },
          {
            "titre": "Parcourir",
            "texte": "Une boucle for de 0 à 2 visite chaque case."
          }
        ]
      },
      "differences": {
        "titres": [
          "Trois variables",
          "Un tableau"
        ],
        "lignes": [
          {
            "critere": "Déclaration",
            "a": "int note1, note2, note3;",
            "b": "int notes[3];"
          },
          {
            "critere": "Parcourir",
            "a": "Impossible avec une boucle",
            "b": "for (int i = 0; i < 3; i++)"
          },
          {
            "critere": "100 valeurs",
            "a": "100 noms différents",
            "b": "int notes[100];"
          }
        ]
      },
      "passages": [
        {
          "texte": "Un tableau est une structure de données qui regroupe une suite d'éléments de même type, rangés de façon contiguë en mémoire et repérés par un indice.",
          "documentId": "wp-tableau",
          "page": "§ Tableau à une dimension"
        },
        {
          "texte": "En C, le premier élément d'un tableau a l'indice 0 et le dernier l'indice taille − 1 ; aucun contrôle n'empêche d'accéder en dehors du tableau.",
          "documentId": "wb-tableaux",
          "page": "Tableaux, § Accès aux éléments"
        },
        {
          "texte": "L'accès à un élément par son indice est immédiat, mais la taille d'un tableau est fixée à sa création.",
          "documentId": "wp-tableau",
          "page": "§ Performances et limites"
        }
      ],
      "infographie": {
        "titre": "Des cases numérotées",
        "points": [
          {
            "icone": "🗄️",
            "texte": "Des cases côte à côte, du même type."
          },
          {
            "icone": "0️⃣",
            "texte": "La première case porte le numéro 0."
          },
          {
            "icone": "🔁",
            "texte": "Une boucle for les parcourt toutes."
          },
          {
            "icone": "⚠️",
            "texte": "Ne jamais dépasser la dernière case."
          }
        ]
      }
