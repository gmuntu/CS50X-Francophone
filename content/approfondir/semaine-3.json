      },
      "passages": [
        {
          "texte": "On mesure souvent la complexité dans le pire des cas : le nombre maximal d'opérations pour une entrée de taille n.",
          "documentId": "wp-complexite",
          "page": "§ Coût dans le pire cas"
        },
        {
          "texte": "La complexité dans le meilleur des cas donne le nombre minimal d'opérations, par exemple quand l'élément cherché est le premier.",
          "documentId": "wp-complexite",
          "page": "§ Coût dans le meilleur cas"
        },
        {
          "texte": "La notation O signifie qu'une fonction est dominée par une autre à une constante près quand n devient grand : on ne garde que le terme qui croît le plus vite.",
          "documentId": "wp-asymptotique",
          "page": "§ Domination"
        }
