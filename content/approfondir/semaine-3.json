    {
      "id": "recursion",
      "titre": "La récursion",
      "resume": "Une fonction récursive s'appelle elle-même sur un problème plus petit, jusqu'à un cas de base qui arrête les appels.",
      "page": "§ Un exemple liminaire : la factorielle",
      "documentId": "wp-recursif",
      "schema": {
        "type": "etapes",
        "etapes": [
          {
            "titre": "Cas de base",
            "texte": "Si n vaut 1 : on répond directement 1."
          },
          {
            "titre": "Cas récursif",
            "texte": "Sinon : factorielle(n) = n × factorielle(n − 1)."
          },
          {
            "titre": "Descendre",
            "texte": "factorielle(3) → 3 × factorielle(2) → 2 × factorielle(1)."
          },
          {
            "titre": "Remonter",
            "texte": "1, puis 2 × 1 = 2, puis 3 × 2 = 6."
          }
        ]
      },
      "differences": {
        "titres": [
          "Boucle (itération)",
          "Récursion"
        ],
        "lignes": [
          {
            "critere": "Répétition",
            "a": "for ou while",
            "b": "La fonction s'appelle elle-même"
          },
          {
            "critere": "Arrêt",
            "a": "La condition de la boucle",
            "b": "Le cas de base"
          },
          {
            "critere": "Exemple CS50",
            "a": "Pyramide avec deux boucles",
            "b": "Pyramide de hauteur n = pyramide n − 1 + une ligne"
          }
        ]
      },
      "passages": [
        {
          "texte": "La factorielle se définit par récurrence : 0! = 1, et n! = n × (n − 1)! ; un algorithme récursif suit exactement cette définition.",
          "documentId": "wp-recursif",
          "page": "§ Un exemple liminaire : la factorielle"
        },
        {
          "texte": "Un algorithme récursif doit toujours prévoir un cas qui se résout sans appel récursif, sinon il ne s'arrêterait jamais.",
          "documentId": "wp-recursif",
          "page": "§ Bien démarrer"
        }
      ],
      "infographie": {
        "titre": "Se rappeler soi-même",
        "points": [
          {
            "icone": "🪆",
            "texte": "Comme des poupées russes : un problème plus petit dedans."
