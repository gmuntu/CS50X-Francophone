
# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="https://www.cs50xfrancophone.online"
NEXTAUTH_SECRET="REMPLACER_PAR_UNE_CLE_SECRETE_ALEATOIRE"

# Configuration optionnelle pour le stockage de fichiers (AWS S3)
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""

# Notes:
# 1. Pour générer NEXTAUTH_SECRET, exécutez: openssl rand -base64 32
# 2. DATABASE_URL doit pointer vers une base PostgreSQL valide
# 3. NEXTAUTH_URL doit correspondre à l'URL de votre site en production
