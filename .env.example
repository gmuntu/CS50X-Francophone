# ---- Base de données ----
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ---- NextAuth ----
# Générer un secret : openssl rand -base64 32
NEXTAUTH_SECRET="votre-secret-nextauth"
AUTH_SECRET="votre-secret-auth"
# NEXTAUTH_URL est géré automatiquement par la plateforme d'hébergement,
# à définir uniquement en local (ex: http://localhost:3000)

# ---- Google SSO (OAuth) ----
GOOGLE_CLIENT_ID="votre-google-client-id"
GOOGLE_CLIENT_SECRET="votre-google-client-secret"

# ---- GitHub OAuth ----
AUTH_GITHUB_ID="votre-github-client-id"
AUTH_GITHUB_SECRET="votre-github-client-secret"

# ---- API Abacus.AI (LLM, notifications, etc.) ----
ABACUSAI_API_KEY="votre-cle-abacusai"

# ---- Google Cloud Text-to-Speech (voix neuronale Socrate) ----
GOOGLE_TTS_API_KEY="votre-cle-google-tts"

# --- Sécurité (obligatoire) ---
AUTH_SECRET=""                 # openssl rand -base64 32
ADMIN_EMAIL=""                 # utilisé par scripts/seed.ts
ADMIN_PASSWORD=""              # 14 caractères minimum, jamais dans le code
COURSE_PRICE_USD="500"

# --- Emails (réinitialisation de mot de passe) : https://resend.com ---
RESEND_API_KEY=""
EMAIL_FROM="Savoiria <noreply@savoiria.online>"

# --- Voix (Google Cloud Text-to-Speech, voix Chirp 3 HD) ---
GOOGLE_TTS_VOICE="fr-FR-Chirp3-HD-Charon"   # autres : fr-FR-Chirp3-HD-Aoede, -Puck, -Kore...

# --- Ordinateurs SavoirIA d'école : Socrate avec Gemini relayé par le site en ligne (site en ligne seulement) ---
# Limites par ordinateur d'école et par jour (réponse 429, l'ordinateur passe alors à Gemma).
POSTE_TUTEUR_PAR_JOUR="300"         # questions écrites ou vocales à Socrate, par ordinateur
POSTE_TUTEUR_INST_PAR_JOUR="2000"   # même chose, pour tous les ordinateurs d'une école
POSTE_LIVE_PAR_JOUR="200"           # conversations Gemini Live (jetons à usage unique), par ordinateur
# Sur l'ordinateur d'école : limite Gemini par élève et par jour (au-delà, Auto passe à Gemma, illimité).
POSTE_ELEVE_PAR_JOUR="60"
POSTE_ELEVE_LIVE_PAR_JOUR="10"
