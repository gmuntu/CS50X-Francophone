# ---- Base de données ----
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ---- NextAuth ----
# Générer un secret : openssl rand -base64 32
NEXTAUTH_SECRET="votre-secret-nextauth"
AUTH_SECRET="votre-secret-auth"
# NEXTAUTH_URL est géré automatiquement par la plateforme d'hébergement,
# à définir uniquement en local (ex: http://localhost:3000)

# ---- Google SSO (OAuth) ----
GOOGLE_CLIENT_ID="votre-google-client-id"
GOOGLE_CLIENT_SECRET="votre-google-client-secret"

# ---- GitHub OAuth ----
AUTH_GITHUB_ID="votre-github-client-id"
AUTH_GITHUB_SECRET="votre-github-client-secret"

# ---- API Abacus.AI (LLM, notifications, etc.) ----
ABACUSAI_API_KEY="votre-cle-abacusai"

# ---- Google Cloud Text-to-Speech (voix neuronale Socrate) ----
GOOGLE_TTS_API_KEY="votre-cle-google-tts"
